# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Hosted Postgres (Supabase: Connect → "Transaction pooler" URI, port 6543). Leave unset locally to use the
# built-in test database in .data/.
DATABASE_URL=

# The site's public address, used in sign-in emails, e.g. https://josh-orr-pool.vercel.app
APP_URL=

# Comma-separated emails that get the Admin screens.
ADMIN_EMAILS=joshrorr@hotmail.com

# Signs session cookies. Required in production; any long random string.
SESSION_SECRET=

# Sends sign-in emails (resend.com). Without it, local sign-in shows the link on screen instead.
RESEND_API_KEY=
# Sender, from a domain verified in Resend, e.g. Josh Orr's Pool <pool@yourdomain.com>
EMAIL_FROM=

# Lets a scheduler call /api/cron/sync. Any long random string.
CRON_SECRET=
